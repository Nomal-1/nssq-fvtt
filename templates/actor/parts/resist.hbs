<section class="resist">
  <h3>{{localize "NSSQ.Resist.label"}}</h3>
  <div class="grid grid-6col">
    {{#if resistRows}}
    {{#each resistRows as |r|}}
    <label class="stat">
      <span>{{nssqLabel "NSSQ.Resist" r.key}}</span>
      <input type="number" name="system.resist.{{r.key}}" value="{{r.base}}" data-dtype="Number"/>
      {{#if r.changed}}<span class="bonus" title="{{localize 'NSSQ.Resist.withEquip'}}">&rarr; {{r.total}}</span>{{/if}}
    </label>
    {{/each}}
    {{else}}
    {{#each resistKeys as |k|}}
    <label class="stat">
      <span>{{nssqLabel "NSSQ.Resist" k}}</span>
      <input type="number" name="system.resist.{{k}}" value="{{lookup @root.system.resist k}}" data-dtype="Number"/>
    </label>
    {{/each}}
    {{/if}}
  </div>
</section>
