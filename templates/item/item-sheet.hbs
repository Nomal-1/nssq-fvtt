<form class="{{cssClass}} nq-sheet" autocomplete="off">
  <header class="nq-head nq-item-head">
    <img class="nq-portrait" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <div class="nq-id">
      <input class="nq-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'NSSQ.Name'}}"/>
      <div class="nq-sub"><span class="nq-tag">{{nssqLabel "TYPES.Item" item.type}}</span></div>
    </div>
  </header>

  <section class="nq-body nq-item-body">
    <div class="nq-fields">
      {{#each fields as |f|}}
      <label class="nq-field">
        <span>{{localize f.label}}</span>
        {{#if f.choices}}
        <select name="{{f.name}}">{{selectOptions f.choices selected=f.value}}</select>
        {{else if (nssqEq f.type "BooleanField")}}
        <input type="checkbox" name="{{f.name}}" {{checked f.value}}/>
        {{else if (nssqEq f.type "NumberField")}}
        <input type="number" name="{{f.name}}" value="{{f.value}}" data-dtype="Number"/>
        {{else}}
        <input type="text" name="{{f.name}}" value="{{f.value}}"/>
        {{/if}}
      </label>
      {{/each}}
    </div>

    {{#if stats}}
    <h3 class="nq-title">{{localize "NSSQ.Inventory.stats"}}</h3>
    <div class="nq-subs">
      {{#each stats as |s|}}<div class="nq-sub-stat"><span>{{localize s.label}}</span><b>{{s.value}}</b></div>{{/each}}
    </div>
    {{/if}}

    {{#if refinements}}
    <h3 class="nq-title">{{localize "NSSQ.Inventory.refined"}} <span class="nq-note">{{refinements.length}}/2</span></h3>
    <ul class="nq-refine-list">
      {{#each refinements as |r|}}<li>{{#if r.badge}}<span class="refine-badge {{r.badge.cls}}"><i class="fas {{r.badge.icon}}"></i> {{r.badge.text}}</span>{{/if}} {{r.name}}{{#if @root.isGM}} <a class="nq-ctl" data-action="remove-refinement" data-key="{{r.key}}" title="{{localize 'NSSQ.Inventory.removeRefinement'}}"><i class="fas fa-times"></i></a>{{/if}}</li>{{/each}}
    </ul>
    {{/if}}

    <h3 class="nq-title">{{localize "NSSQ.Tab.description"}}</h3>
    <div class="nq-description">
      {{editor enrichedDescription target="system.description" button=true editable=editable owner=owner}}
    </div>
  </section>
</form>
