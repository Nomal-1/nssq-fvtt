   "areas": [
    {
     "id": "wA1",
     "name": "숲의 입구",
     "x": 100,
     "y": 470,
     "img": "6d91cb014b8c24243b5fb25e2833e08a.jpg",
     "terrain": "볕이 드는 숲길의 시작",
     "gmNote": "",
     "secret": false,
     "gather": "",
     "tags": "",
     "triggers": [
      {
       "id": "wT1",
       "on": "visit",
       "n": 1,
       "once": true,
       "text": "",
       "playerText": "",
       "actions": [
        {
         "type": "message",
         "text": "나무 사이로 길이 이어진다. 미궁 「속삭이는 숲」에 들어섰다.\n입구에서는 언제든 「마을로 돌아간다」를 고를 수 있다."
        }
       ]
      }
     ],
     "encounters": [],
     "narration": "새들의 지저귐이 멀어지고, 발밑의 흙이 부드러워진다. 여기서부터가 미궁이다."
    },
    {
     "id": "wA2",
     "name": "햇살 오솔길",
     "x": 270,
     "y": 470,
     "img": "자료/일러/26954f842a83210459c31b429b039f73.jpg",
     "terrain": "나뭇잎 사이로 햇빛이 쏟아지는 길",
     "gmNote": "볕이 잘 드는 곳. 햇빛을 모으는 니치린소와 그 공생 벌레(오일 웜)는 이 숲에서 여기에만 산다.",
     "secret": false,
     "gather": "~6: R1 풀 / 7~10: R1 꽃 / 11~: R1 열매",
     "tags": "",
     "triggers": [],
     "encounters": [
      {
       "id": "nssqDefEncW1",
       "weight": 2
      },
      {
       "id": "nssqDefEncW2",
       "weight": 1
      }
     ],
     "narration": "머리 위 가지가 성글어 햇빛이 길을 비춘다. 길가에 꽃과 약초가 흐드러져 있다."
    },
    {
     "id": "wA3",
     "name": "개울가",
     "x": 270,
     "y": 260,
     "img": "edde2c4b8c8fce7aafbd451ea7bbbfbd.jpg",
     "terrain": "맑은 물소리가 들리는 물가",
     "gmNote": "물가 생물(물어뜯치·삼림개구리)이 나온다. 조사하면 낚시 이벤트.",
     "secret": false,
     "gather": "",
     "tags": "",
     "triggers": [
      {
       "id": "wT2",
       "on": "search",
       "n": 1,
       "once": false,
       "text": "낚시: 원하면 대표자에게 【LUC】 판정(목표값 9)을 시킨다. 성공하면 「생선」 1개(달성값 12 이상이면 2개)를 준다. 2D6이 모두 1이면 물어뜯치×2가 물 밖으로 튀어 오른다(전투). 생선은 캠프의 식료품으로 쓸 수 있다.",
       "playerText": "물살이 느린 웅덩이에 물고기 그림자가 어른거린다.",
       "actions": [
        {
         "type": "check",
         "ability": "luc",
         "checkKind": "",
         "target": 9,
         "note": "낚시"
        }
       ]
      }
     ],
     "encounters": [
      {
       "id": "nssqDefEncW3",
       "weight": 2
      },
      {
       "id": "nssqDefEncW4",
       "weight": 1
      }
     ],
     "narration": "자갈 사이로 맑은 개울이 흐른다. 물가의 진흙에 작은 발자국이 어지럽게 찍혀 있다."
    },
    {
     "id": "wA4",
     "name": "고사리 덤불",
     "x": 470,
     "y": 470,
     "img": "자료/일러/a60aac4f5e2a47571e92a91de28b3209.jpg",
     "terrain": "키 큰 고사리가 하늘을 가린 어두운 덤불",
     "gmNote": "빛이 거의 들지 않아 식물형 에너미는 없다. 광란의 뿔사슴이 지나다니는 길목. 조사하면 모험가의 상자.",
     "secret": false,
     "gather": "",
     "tags": "",
     "triggers": [
      {
       "id": "wT3",
       "on": "search",
       "n": 1,
       "once": false,
       "text": "모험가의 상자: 다른 모험가가 두고 간 물건이 들어 있다. 무엇이 들었는지는 GM이 정해 준다(예: 메디카 1개, 넥타르 1개, 낡은 단검). PC가 물건을 넣으면 다음에 올 누군가를 위해 남는다.",
       "playerText": "고사리 그늘에 낡은 나무 상자가 놓여 있다. 뚜껑에 「필요한 것을 가져가고, 남는 것을 두고 가라」고 새겨져 있다.",
       "actions": []
      }
     ],
     "encounters": [
      {
       "id": "nssqDefEncW5",
       "weight": 2
      },
      {
       "id": "nssqDefEncW6",
       "weight": 1
      }
     ],
     "narration": "고사리가 머리 위까지 자라 빛이 끊긴다. 축축한 흙냄새 속에 짐승의 냄새가 섞여 있다."
    },
    {
     "id": "wA5",
     "name": "사슴의 길",
     "x": 560,
     "y": 260,
     "img": "자료/일러/284843472b386ef42660d3b1e0cd4980.jpg",
     "terrain": "풀이 짓밟혀 다져진 짐승길",
     "gmNote": "광란의 뿔사슴이 오가는 길이라 다른 짐승은 다가오지 않는다(랜덤 조우 없음). 뿔사슴을 쓰러뜨리면 이 에어리어의 숨은 통로(→ 안개 오솔길)를 지도 창에서 공개한다.",
     "secret": false,
     "gather": "",
     "tags": "",
     "triggers": [
      {
       "id": "wT4",
       "on": "search",
       "n": 1,
       "once": false,
       "text": "뿔사슴이 살아 있으면 안개 너머로는 갈 수 없다. 쓰러뜨렸다면 숨은 통로를 공개한다.",
       "playerText": "짓밟힌 풀 사이로 커다란 굽 자국이 이어진다. 굽 자국은 길 북쪽의 짙은 안개 앞에서 끊겨 있다.",
       "actions": []
      }
     ],
     "encounters": [],
     "narration": "무언가 거대한 것이 몇 번이고 지나다닌 길이다. 나무껍질이 높은 곳까지 뿔에 긁혀 벗겨져 있다."
    },
    {
     "id": "wA6",
     "name": "쓰러진 고목",
     "x": 670,
     "y": 470,
     "img": "자료/일러/e92bc974d6de6f9920b60d04d986005a.jpg",
     "terrain": "거대한 고목이 쓰러져 길을 막은 곳",
     "gmNote": "껍질이 단단한 에너미(숲달팽이 방어 7, 볼 애니멀 방어 7·참/돌 내성 4, 크롤러 HP 9). 속성 공격 없이 오면 고전한다. 조사하면 썩은 둥치 속 상자.",
     "secret": false,
     "gather": "~6: R1 목재 / 7~10: R1 가지 / 11~: R1 덩굴",
     "tags": "",
     "triggers": [
      {
       "id": "wT5",
       "on": "search",
       "n": 1,
       "once": true,
       "text": "썩은 둥치 속 상자: 【STR】 판정(목표값 10)으로 꺼낸다. 성공하면 GM이 보상을 준다(예: 100G 또는 메디카 2개). 실패해도 다시 조사할 수 있지만 1세그먼트가 흐른다.",
       "playerText": "썩어 갈라진 둥치 안쪽에 무언가 끼어 있다.",
       "actions": [
        {
         "type": "check",
         "ability": "str",
         "checkKind": "",
         "target": 10,
         "note": "썩은 둥치 속 상자"
        }
       ]
      }
     ],
     "encounters": [
      {
       "id": "nssqDefEncW7",
       "weight": 1
      },
      {
       "id": "nssqDefEncW8",
       "weight": 1
      }
     ],
     "narration": "길을 가로질러 거대한 고목이 쓰러져 있다. 이끼 낀 줄기 아래로 무언가 꿈틀거린다."
    },
    {
