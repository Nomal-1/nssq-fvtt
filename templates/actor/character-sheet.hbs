<form class="{{cssClass}} nq-sheet" autocomplete="off">
  <header class="nq-head">
    <div class="nq-portrait-wrap">
      <img class="nq-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      {{#if owner}}<a class="nq-art-btn" data-action="edit-art" title="{{localize 'NSSQ.Art.open'}}"><i class="fas fa-portrait"></i></a>{{/if}}
    </div>
    <div class="nq-id">
      <input class="nq-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'NSSQ.Name'}}"/>
      <div class="nq-sub">
        <label class="nq-lv">Lv <input type="number" name="system.level" value="{{system.level}}" data-dtype="Number"/></label>
        {{#if classes.main}}
        <select class="nq-class" style="width: {{mainClassWidth}}em" name="system.mainClass" title="{{localize 'NSSQ.Class.main'}}">{{selectOptions mainClassChoices selected=mainClassKey}}</select>
        <span class="nq-slash">/</span>
        <select class="nq-class sub" style="width: {{subClassWidth}}em" name="system.subClass" title="{{localize 'NSSQ.Class.sub'}}">{{selectOptions subClassChoices selected=subClassKey}}</select>
        {{else}}<span class="nq-hint">{{localize "NSSQ.Class.dropHint"}}</span>{{/if}}
        <select class="nq-row" name="system.row" title="{{localize 'NSSQ.Row.label'}}">{{selectOptions rowChoices selected=system.row localize=true}}</select>
      </div>
      <div class="nq-bars">
        <span class="nq-bar-label hp">HP</span>
        <div class="nq-bar hp"><i style="width: {{hpPct}}%"></i></div>
        <span class="nq-bar-val"><input type="number" name="system.hp.value" value="{{system.hp.value}}" data-dtype="Number"/> / {{system.hp.max}}</span>
        <span class="nq-bar-label tp">TP</span>
        <div class="nq-bar tp"><i style="width: {{tpPct}}%"></i></div>
        <span class="nq-bar-val"><input type="number" name="system.tp.value" value="{{system.tp.value}}" data-dtype="Number"/> / {{system.tp.max}}</span>
      </div>
    </div>
    <div class="nq-side">
      <label class="nq-chip fp"><span>FP</span><input type="number" name="system.fp.value" value="{{system.fp.value}}" data-dtype="Number"/></label>
      <label class="nq-chip"><span>{{localize "NSSQ.Sheet.money"}}</span><input type="number" name="system.money" value="{{system.money}}" data-dtype="Number"/><em>G</em></label>
      <div class="nq-chip {{#if inventory.over}}over{{/if}}" title="{{localize 'NSSQ.Inventory.carryHint'}}"><span>{{localize "NSSQ.Sheet.carry"}}</span><b>{{system.carried}} / {{system.carry}}</b></div>
      <label class="nq-chip"><span>{{localize "NSSQ.Exp"}}</span><input type="number" name="system.exp" value="{{system.exp}}" data-dtype="Number"/></label>
    </div>
  </header>

  <div class="nq-actions">
    {{#if canAttack}}<button type="button" data-action="normal-attack" title="{{localize 'NSSQ.Combat.normalAttackHint'}}"><i class="fas fa-fist-raised"></i> {{localize "NSSQ.Combat.normalAttack"}}</button>{{/if}}
    {{#if editable}}{{#if sheet.growth.left}}<button type="button" class="nq-growth-btn" data-action="roll-growth" title="{{localize 'NSSQ.Growth.hint'}}"><i class="fas fa-seedling"></i> {{localize "NSSQ.Growth.button"}} ({{sheet.growth.left}})</button>{{/if}}{{/if}}
    {{#if sheet.canRollAbilities}}{{#if editable}}<button type="button" data-action="roll-abilities" title="{{localize 'NSSQ.AbilityRoll.hint'}}"><i class="fas fa-dice"></i> {{localize "NSSQ.AbilityRoll.title"}}</button>{{/if}}{{/if}}
    <span class="nq-spacer"></span>
    {{#if showNpcToggle}}<label class="nq-toggle" title="{{localize 'NSSQ.Party.npcHint'}}"><input type="checkbox" name="system.npc" {{checked system.npc}}/> {{localize "NSSQ.Party.npc"}}</label>{{/if}}
  </div>

  <nav class="nq-tabs sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main"><i class="fas fa-user-shield"></i> {{localize "NSSQ.Tab.main"}}</a>
    <a class="item" data-tab="inventory"><i class="fas fa-suitcase"></i> {{localize "NSSQ.Tab.inventory"}}</a>
    <a class="item" data-tab="skills"><i class="fas fa-book-open"></i> {{localize "NSSQ.Tab.skills"}}</a>
    <a class="item" data-tab="description"><i class="fas fa-feather"></i> {{localize "NSSQ.Tab.description"}}</a>
  </nav>

  <section class="sheet-body nq-body">
    <div class="tab" data-group="primary" data-tab="main">
      <div class="nq-cols">
        <div class="nq-col">
          <h3 class="nq-title">{{localize "NSSQ.Ability.label"}} <span class="nq-note">{{localize "NSSQ.Sheet.abilityNote"}}</span>
            {{#if editable}}<button type="button" class="nq-title-btn" data-action="edit-abilities" title="{{localize 'NSSQ.Sheet.editAbilitiesHint'}}"><i class="fas fa-pen"></i> {{localize "NSSQ.Sheet.editAbilities"}}</button>{{/if}}
          </h3>
          <div class="nq-ability-cards">
            {{#each sheet.abilityCards as |a|}}
            <div class="nq-ability {{#if a.boosted}}boosted{{/if}}" title="{{a.tooltip}}">
              <a class="nq-ability-roll" data-action="roll-ability" data-ability="{{a.key}}">
                <span class="nq-ability-name"><i class="fas fa-dice-d6"></i> {{a.short}}</span>
                <b class="nq-ability-val">{{a.total}}</b>
                <span class="nq-ability-b">B {{a.b}}</span>
              </a>
            </div>
            {{/each}}
          </div>

          <h3 class="nq-title">{{localize "NSSQ.Resist.label"}} <span class="nq-note">{{localize "NSSQ.Sheet.resistNote"}}</span></h3>
          <div class="nq-resists">
            {{#each sheet.resist as |r|}}
            <div class="nq-resist {{r.key}} {{#if r.changed}}changed{{/if}}">
              <span class="nq-resist-name">{{r.label}}</span>
              <b class="nq-resist-final" title="{{localize 'NSSQ.Resist.finalHint'}}">{{r.total}}</b>
              <input type="number" name="system.resist.{{r.key}}" value="{{r.base}}" data-dtype="Number" title="{{localize 'NSSQ.Resist.baseHint'}}"/>
            </div>
            {{/each}}
          </div>

          {{#if isGM}}
          <details class="nq-gm-panel" {{#unless sheet.creation.locked}}open{{/unless}}>
            <summary><i class="fas fa-user-secret"></i> {{localize "NSSQ.Sheet.creationRecord"}}
              {{#if sheet.creation.locked}}<span class="nq-tag locked"><i class="fas fa-lock"></i> {{localize "NSSQ.Sheet.locked"}}</span>{{else}}<span class="nq-tag">{{localize "NSSQ.Sheet.unlocked"}}</span>{{/if}}
            </summary>
            <div class="nq-gm-body">
              <div class="nq-kv"><span>{{localize "NSSQ.Sheet.rollCount"}}</span><b>{{sheet.creation.rollCount}}</b></div>
              {{#if sheet.creation.totals}}
              <div class="nq-kv"><span>{{localize "NSSQ.Sheet.rolledValues"}}</span><b>{{#each sheet.creation.totals}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</b> <em>({{localize "NSSQ.AbilityRoll.sum"}} {{sheet.creation.sum}} · {{localize "NSSQ.AbilityRoll.money"}} {{sheet.creation.money}}G)</em></div>
              {{/if}}
              {{#if sheet.creation.assign}}<div class="nq-kv"><span>{{localize "NSSQ.Sheet.assigned"}}</span><b>{{sheet.creation.assign}}</b></div>{{/if}}
              <div class="nq-kv"><span>{{localize "NSSQ.Sheet.recentLog"}}</span>{{#if (nssqGt sheet.creation.total 6)}}<a data-action="show-log"><i class="fas fa-list"></i> {{localize "NSSQ.Sheet.fullLog"}} ({{sheet.creation.total}})</a>{{/if}}</div>
              <ol class="nq-log">
                {{#each sheet.creation.entries as |e|}}<li><span class="when">{{e.when}} · {{e.user}}</span> {{e.text}}</li>{{else}}<li class="empty">{{localize "NSSQ.Sheet.logEmpty"}}</li>{{/each}}
              </ol>
              <button type="button" data-action="toggle-lock"><i class="fas {{#if sheet.creation.locked}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{#if sheet.creation.locked}}{{localize "NSSQ.Sheet.unlock"}}{{else}}{{localize "NSSQ.Sheet.lock"}}{{/if}}</button>
              <p class="nq-note">{{localize "NSSQ.Sheet.lockNote"}}</p>
            </div>
          </details>
          {{/if}}
        </div>

        <div class="nq-col">
          <h3 class="nq-title">{{localize "NSSQ.Sub.label"}}</h3>
          <div class="nq-subs">
            {{#each sheet.subStats as |s|}}
            <div class="nq-sub-stat {{#if s.changed}}changed{{/if}}" title="{{s.tooltip}}"><span>{{s.label}}</span><b>{{s.value}}</b></div>
            {{/each}}
          </div>
          {{#if sheet.status.length}}
          <h3 class="nq-title">{{localize "NSSQ.Sheet.statusTitle"}}</h3>
          <ul class="nq-status-list">
            {{#each sheet.status as |st|}}<li class="{{st.cls}}" title="{{st.hint}}">{{st.label}}</li>{{/each}}
          </ul>
          {{/if}}

          <h3 class="nq-title">{{localize "NSSQ.Inventory.equipped"}}</h3>
          <ul class="nq-equip">
            {{#each sheet.equip as |e|}}
            <li class="{{#if e.item}}filled{{/if}}" {{#if e.item}}data-item-id="{{e.item.id}}"{{/if}}>
              <span class="nq-equip-slot" title="{{e.label}}"><i class="fas {{e.icon}}"></i><em>{{e.label}}</em></span>
              {{#if e.item}}
              <img class="nq-equip-img" src="{{e.item.img}}" data-action="item-edit"/>
              <div class="nq-equip-main">
                <div><a class="nq-equip-name" data-action="item-edit">{{e.item.name}}</a> {{#if e.item.rank}}<span class="nq-rank">{{e.item.rank}}</span>{{/if}}</div>
                {{> "systems/nssq/templates/actor/parts/refine-badges.hbs" refine=e.item.refine}}
              </div>
              {{else}}<span class="nq-empty">{{#if (nssqEq e.slot "weapon")}}{{#if @root.sheet.weaponLine}}{{@root.sheet.weaponLine}}{{else}}{{localize "NSSQ.Inventory.empty"}}{{/if}}{{else}}{{localize "NSSQ.Inventory.empty"}}{{/if}}</span>{{/if}}
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="inventory">
      {{> "systems/nssq/templates/actor/parts/inventory.hbs"}}
    </div>
    <div class="tab" data-group="primary" data-tab="skills">
      {{> "systems/nssq/templates/actor/parts/skills.hbs"}}
    </div>
    <div class="tab nq-description" data-group="primary" data-tab="description">
      {{editor enrichedDescription target="system.description" button=true editable=editable owner=owner}}
    </div>
  </section>
</form>
