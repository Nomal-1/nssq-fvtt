<ol class="item-list">
  {{#each items as |item|}}
  <li class="item flexrow" data-item-id="{{item.id}}">
    <img class="item-img" src="{{item.img}}" width="24" height="24"/>
    <span class="item-name">{{item.name}}</span>
    <span class="item-type">{{nssqLabel "TYPES.Item" item.type}}</span>
    <a class="item-control" data-action="item-edit" title="{{localize 'NSSQ.Edit'}}"><i class="fas fa-edit"></i></a>
    {{#if @root.editable}}<a class="item-control" data-action="item-delete" title="{{localize 'NSSQ.Delete'}}"><i class="fas fa-trash"></i></a>{{/if}}
  </li>
  {{else}}
  <li class="empty">{{localize "NSSQ.NoItems"}}</li>
  {{/each}}
</ol>
