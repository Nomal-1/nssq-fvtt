<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'NSSQ.Name'}}"/></h1>
      <div class="item-type">{{nssqLabel "TYPES.Item" item.type}}</div>
    </div>
  </header>
  <section class="fields grid grid-2col">
    {{#each fields as |f|}}
    <label class="stat">
      <span>{{localize f.label}}</span>
      {{#if f.choices}}
      <select name="{{f.name}}">{{selectOptions f.choices selected=f.value}}</select>
      {{else if (nssqEq f.type "BooleanField")}}
      <input type="checkbox" name="{{f.name}}" {{checked f.value}}/>
      {{else if (nssqEq f.type "NumberField")}}
      <input type="number" name="{{f.name}}" value="{{f.value}}" data-dtype="Number"/>
      {{else}}
      <input type="text" name="{{f.name}}" value="{{f.value}}"/>
      {{/if}}
    </label>
    {{/each}}
  </section>
  {{#if stats}}
  <section class="item-stats">
    <h3>{{localize "NSSQ.Inventory.stats"}}</h3>
    <div class="grid grid-3col">
      {{#each stats as |s|}}<div class="stat"><span>{{localize s.label}}</span><span class="value">{{s.value}}</span></div>{{/each}}
    </div>
  </section>
  {{/if}}
  {{#if refinements}}
  <section class="item-refinements">
    <h3>{{localize "NSSQ.Inventory.refined"}} ({{refinements.length}}/2)</h3>
    <ul>
      {{#each refinements as |r|}}<li>{{#if r.badge}}<span class="refine-badge {{r.badge.cls}}"><i class="fas {{r.badge.icon}}"></i> {{r.badge.text}}</span>{{/if}} {{r.name}}{{#if @root.isGM}} <a data-action="remove-refinement" data-key="{{r.key}}" title="{{localize 'NSSQ.Inventory.removeRefinement'}}"><i class="fas fa-times"></i></a>{{/if}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}
  <section class="sheet-body">
    {{editor enrichedDescription target="system.description" button=true editable=editable owner=owner}}
  </section>
</form>
