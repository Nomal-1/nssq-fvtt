<section class="resist">
  <h3>{{localize "NSSQ.Resist.label"}}</h3>
  {{#if resistRows}}
  <table class="resist-table">
    <thead><tr><th></th>{{#each resistRows as |r|}}<th>{{nssqLabel "NSSQ.Resist" r.key}}</th>{{/each}}</tr></thead>
    <tbody>
      <tr>
        <th title="{{localize 'NSSQ.Resist.baseHint'}}">{{localize "NSSQ.Resist.base"}}</th>
        {{#each resistRows as |r|}}<td><input type="number" name="system.resist.{{r.key}}" value="{{r.base}}" data-dtype="Number"/></td>{{/each}}
      </tr>
      <tr class="final">
        <th title="{{localize 'NSSQ.Resist.finalHint'}}">{{localize "NSSQ.Resist.final"}}</th>
        {{#each resistRows as |r|}}<td class="{{#if r.changed}}changed{{/if}}">{{r.total}}</td>{{/each}}
      </tr>
    </tbody>
  </table>
  {{else}}
  <div class="grid grid-6col">
    {{#each resistKeys as |k|}}
    <label class="stat">
      <span>{{nssqLabel "NSSQ.Resist" k}}</span>
      <input type="number" name="system.resist.{{k}}" value="{{lookup @root.system.resist k}}" data-dtype="Number"/>
    </label>
    {{/each}}
  </div>
  {{/if}}
</section>
