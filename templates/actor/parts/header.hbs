<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="96" width="96"/>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'NSSQ.Name'}}"/></h1>
    <div class="header-actions">
      {{#if canAttack}}<button type="button" class="attack-btn" data-action="normal-attack" title="{{localize 'NSSQ.Combat.normalAttackHint'}}"><i class="fas fa-fist-raised"></i> {{localize "NSSQ.Combat.normalAttack"}}</button>{{/if}}
      {{#if showNpcToggle}}<label class="npc-toggle" title="{{localize 'NSSQ.Party.npcHint'}}"><input type="checkbox" name="system.npc" {{checked system.npc}}/> {{localize "NSSQ.Party.npc"}}</label>{{/if}}
    </div>
  </div>
</header>
