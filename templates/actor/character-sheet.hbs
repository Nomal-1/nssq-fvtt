<form class="{{cssClass}}" autocomplete="off">
  {{> "systems/nssq/templates/actor/parts/header.hbs"}}
  <section class="resources grid grid-4col">
    <label class="stat"><span>{{localize "NSSQ.Level"}}</span><input type="number" name="system.level" value="{{system.level}}" data-dtype="Number"/></label>
    <label class="stat"><span>{{localize "NSSQ.Exp"}}</span><input type="number" name="system.exp" value="{{system.exp}}" data-dtype="Number"/></label>
    <label class="stat"><span>{{localize "NSSQ.Money"}}</span><input type="number" name="system.money" value="{{system.money}}" data-dtype="Number"/></label>
    <label class="stat"><span>{{localize "NSSQ.Row.label"}}</span>
      <select name="system.row">{{selectOptions rowChoices selected=system.row localize=true}}</select></label>
    <label class="stat"><span>{{localize "NSSQ.HP"}}</span>
      <span class="pair"><input type="number" name="system.hp.value" value="{{system.hp.value}}" data-dtype="Number"/> / {{system.hp.max}}</span></label>
    <label class="stat"><span>{{localize "NSSQ.TP"}}</span>
      <span class="pair"><input type="number" name="system.tp.value" value="{{system.tp.value}}" data-dtype="Number"/> / {{system.tp.max}}</span></label>
    <label class="stat"><span>{{localize "NSSQ.FP"}}</span><input type="number" name="system.fp.value" value="{{system.fp.value}}" data-dtype="Number"/></label>
    <div class="stat"><span>{{localize "NSSQ.Carry"}}</span><span class="value">{{system.carry}}</span></div>
  </section>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">{{localize "NSSQ.Tab.main"}}</a>
    <a class="item" data-tab="items">{{localize "NSSQ.Tab.items"}}</a>
    <a class="item" data-tab="description">{{localize "NSSQ.Tab.description"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="main">
      <section class="abilities">
        <h3 class="section-title">{{localize "NSSQ.Ability.label"}}
          {{#if editable}}<a class="section-action" data-action="roll-abilities" title="{{localize 'NSSQ.AbilityRoll.hint'}}"><i class="fas fa-dice"></i> {{localize "NSSQ.AbilityRoll.title"}}</a>{{/if}}</h3>
        <div class="grid grid-5col">
          {{#each abilityKeys as |k|}}
          <div class="stat">
            <a class="rollable" data-action="roll-ability" data-ability="{{k}}" title="{{localize 'NSSQ.Check.rollHint'}}"><i class="fas fa-dice-d6"></i> {{nssqLabel "NSSQ.Ability" k}}</a>
            <input type="number" name="system.abilities.{{k}}" value="{{lookup @root.system.abilities k}}" data-dtype="Number"/>
            <span class="bonus">B {{lookup @root.system.bonus k}}</span>
          </div>
          {{/each}}
        </div>
      </section>
      <section class="substats">
        <h3>{{localize "NSSQ.Sub.label"}}</h3>
        <div class="grid grid-3col">
          {{#each subKeys as |k|}}
          <div class="stat"><span>{{nssqLabel "NSSQ.Sub" k}}</span><span class="value">{{lookup @root.system.sub k}}</span></div>
          {{/each}}
        </div>
      </section>
      {{> "systems/nssq/templates/actor/parts/resist.hbs"}}
    </div>
    <div class="tab" data-group="primary" data-tab="items">
      {{> "systems/nssq/templates/actor/parts/items.hbs"}}
    </div>
    <div class="tab" data-group="primary" data-tab="description">
      {{editor enrichedDescription target="system.description" button=true editable=editable owner=owner}}
    </div>
  </section>
</form>
