<section class="inventory">
  <header class="inventory-header">
    <span class="carry {{#if inventory.over}}over{{/if}}" title="{{localize 'NSSQ.Inventory.carryHint'}}">
      <i class="fas fa-suitcase"></i> {{localize "NSSQ.Inventory.carried"}} {{inventory.carried}} / {{inventory.carry}}
    </span>
    <span class="money"><i class="fas fa-coins"></i> {{system.money}}G</span>
    {{#if editable}}<button type="button" class="shop-btn" data-action="shop"><i class="fas fa-store"></i> {{localize "NSSQ.Shop.title"}}</button>{{/if}}
  </header>

  <h3>{{localize "NSSQ.Inventory.equipped"}}</h3>
  <ol class="slot-list">
    {{#each inventory.slots as |s|}}
    <li class="slot flexrow" {{#if s.item}}data-item-id="{{s.item.id}}"{{/if}}>
      <span class="slot-label">{{localize s.label}}{{#if s.item.sub}} ({{localize "NSSQ.Slot.sub"}}){{/if}}</span>
      {{#if s.item}}
        <img class="item-img" src="{{s.item.img}}" width="24" height="24"/>
        <span class="item-name"><a data-action="item-edit">{{s.item.name}}</a> {{s.item.rank}}</span>
        <span class="item-summary">{{s.item.summary}}</span>
        {{#if @root.editable}}
          {{#if s.item.refinable}}<a class="item-control" data-action="refine" title="{{localize 'NSSQ.Shop.refine'}}"><i class="fas fa-hammer"></i></a>{{/if}}
          <a class="item-control" data-action="unequip" title="{{localize 'NSSQ.Inventory.unequip'}}"><i class="fas fa-times-circle"></i></a>
        {{/if}}
      {{else}}
        <span class="slot-empty">{{localize "NSSQ.Inventory.empty"}}</span>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  <p class="weapon-line"><i class="fas fa-crosshairs"></i> {{inventory.weaponLine}}</p>

  {{#each inventory.groups as |g|}}
  <h3>{{localize g.label}}</h3>
  <ol class="item-list">
    {{#each g.items as |i|}}
    <li class="item flexrow" data-item-id="{{i.id}}">
      <img class="item-img" src="{{i.img}}" width="24" height="24"/>
      <span class="item-name"><a data-action="item-edit">{{i.name}}</a> {{i.rank}}</span>
      <span class="item-summary">{{i.summary}}</span>
      {{#if i.stackable}}
        <input class="item-qty" type="number" min="0" value="{{i.quantity}}" data-action="quantity" {{#unless @root.editable}}disabled{{/unless}}/>
      {{/if}}
      {{#if @root.editable}}
        {{#if i.equippable}}<a class="item-control" data-action="equip" title="{{localize 'NSSQ.Inventory.equip'}}"><i class="fas fa-shield-alt"></i></a>{{/if}}
        {{#if i.canSub}}<a class="item-control" data-action="equip" data-slot="other" title="{{localize 'NSSQ.Inventory.equipSub'}}"><i class="fas fa-exchange-alt"></i></a>{{/if}}
        {{#if i.refinable}}<a class="item-control" data-action="refine" title="{{localize 'NSSQ.Shop.refine'}}"><i class="fas fa-hammer"></i></a>{{/if}}
        {{#if i.canStore}}<a class="item-control" data-action="store" title="{{localize 'NSSQ.Storage.toStorage'}}"><i class="fas fa-warehouse"></i></a>{{/if}}
        <a class="item-control" data-action="sell" title="{{localize 'NSSQ.Shop.sellFor' price=i.sell}}"><i class="fas fa-coins"></i></a>
        <a class="item-control" data-action="item-delete" title="{{localize 'NSSQ.Delete'}}"><i class="fas fa-trash"></i></a>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="empty">{{localize "NSSQ.NoItems"}}</p>
  {{/each}}

  {{#if @root.isGM}}{{#if inventory.storageSetting}}
  <label class="storage-toggle"><input type="checkbox" name="system.storageEnabled" {{checked inventory.storageEnabled}}/> {{localize "NSSQ.Storage.enableForActor"}}</label>
  {{/if}}{{/if}}

  {{#if inventory.showStorage}}
  <section class="storage">
    <h3><i class="fas fa-warehouse"></i> {{localize "NSSQ.Storage.title"}}{{#unless inventory.storage}} <span class="notes">({{localize "NSSQ.Storage.off"}})</span>{{/unless}}</h3>
    <ol class="item-list">
      {{#each inventory.stored as |i|}}
      <li class="item flexrow" data-item-id="{{i.id}}">
        <img class="item-img" src="{{i.img}}" width="24" height="24"/>
        <span class="item-name"><a data-action="item-edit">{{i.name}}</a> {{i.rank}}</span>
        <span class="item-summary">{{i.summary}}</span>
        {{#if i.stackable}}<span class="item-qty">×{{i.quantity}}</span>{{/if}}
        {{#if @root.editable}}<a class="item-control" data-action="retrieve" title="{{localize 'NSSQ.Storage.retrieve'}}"><i class="fas fa-sign-out-alt"></i></a>{{/if}}
      </li>
      {{else}}
      <li class="empty">{{localize "NSSQ.Storage.empty"}}</li>
      {{/each}}
    </ol>
  </section>
  {{/if}}
</section>
