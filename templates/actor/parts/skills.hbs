<section class="nq-skills">
  <div class="nq-classes">
    {{#each inventory.classes as |c|}}
    <div class="nq-class-card" data-item-id="{{c.id}}">
      <img src="{{c.img}}"/>
      <a data-action="item-edit">{{c.name}}</a>
      {{#if @root.editable}}<a class="nq-ctl" data-action="item-delete" title="{{localize 'NSSQ.Delete'}}"><i class="fas fa-times"></i></a>{{/if}}
    </div>
    {{else}}
    <p class="nq-empty">{{localize "NSSQ.Class.dropHint"}}</p>
    {{/each}}
  </div>

  {{#each inventory.skillGroups as |g|}}
  <section class="nq-skill-group {{g.cls}}" data-skill-group="{{g.cls}}">
    <h3 class="nq-title">{{g.title}} <span class="nq-note">{{g.skills.length}}</span></h3>
    <ol class="nq-skill-list">
      {{#each g.skills as |s|}}
      <li class="nq-skill" data-item-id="{{s.id}}" data-skill-key="{{s.skillKey}}">
        <img src="{{s.img}}"/>
        <a class="nq-skill-name" data-action="item-edit">{{#if s.unique}}<span class="nq-unique" title="{{localize 'NSSQ.Skill.unique'}}">★</span>{{/if}}{{s.name}}</a>
        <span class="nq-timing {{s.timingCls}}">{{s.timing}}</span>
        {{#if s.cost}}<span class="nq-cost">{{s.cost}}</span>{{/if}}
        <span class="nq-sl" title="{{#if s.prereq}}{{localize 'NSSQ.Skill.prereq'}}: {{s.prereq}}{{/if}}">SL {{s.sl}}{{#if s.max}}<em>/{{s.max}}</em>{{/if}}</span>
        {{#if @root.editable}}<a class="nq-ctl" data-action="item-delete" title="{{localize 'NSSQ.Delete'}}"><i class="fas fa-trash"></i></a>{{/if}}
      </li>
      {{/each}}
    </ol>
  </section>
  {{else}}
  <p class="nq-empty">{{localize "NSSQ.Skill.none"}}</p>
  {{/each}}
</section>
